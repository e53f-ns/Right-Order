{
  "name": "crypto-arbitrage-scanner",
  "version": "0.1.0",
  "description": "Real-time crypto arbitrage opportunity scanner",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prebuild": "rm -rf node_modules/.prisma src/generated/prisma && npm run prisma:generate",
    "postinstall": "prisma generate || true",
    "start": "node dist/dashboard-main.js",
    "dev": "tsx watch src/index.ts",
    "dev:dashboard": "tsx watch src/dashboard-main.ts",
    "dev:all": "tsx watch src/index-with-dashboard.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run prisma:generate && tsc --outDir dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "crypto",
    "arbitrage",
    "trading",
    "scanner"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "bcrypt": "^6.0.0",
    "ccxt": "^4.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.19.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "prisma": "^7.4.1",
    "protobufjs": "^8.0.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "stripe": "^20.4.0",
    "telegraf": "^4.16.3",
    "uuid": "^13.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.17",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.30.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
