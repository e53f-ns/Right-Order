      <div class="dex-header">
        <h2>DEX Scanner</h2>
        <span class="dex-status" id="dexStatus">Initializing...</span>
      </div>
      
      <!-- DEX Filters -->
      <div class="filters dex-filters">
        <div class="filter-group">
          <label for="dexFilterMinNet">Min Net %</label>
          <input type="number" id="dexFilterMinNet" value="-0.5" step="0.1">
        </div>
        <div class="filter-group">
          <label for="dexFilterDex">DEX</label>
          <select id="dexFilterDex">
            <option value="all">All DEXs</option>
            <option value="uniswap_v3">Uniswap V3</option>
            <option value="pancakeswap">PancakeSwap</option>
            <option value="sushiswap">SushiSwap</option>
            <option value="quickswap">QuickSwap</option>
            <option value="camelot">Camelot</option>
            <option value="velodrome">Velodrome</option>
            <option value="aerodrome">Aerodrome</option>
            <option value="trader_joe">Trader Joe</option>
            <option value="raydium">Raydium</option>
            <option value="orca">Orca</option>
            <option value="jupiter">Jupiter</option>
            <option value="balancer">Balancer</option>
            <option value="curve">Curve</option>
            <option value="oneinch">1inch</option>
            <option value="kyberswap">KyberSwap</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="dexFilterChain">Chain</label>
          <select id="dexFilterChain">
            <option value="all">All Chains</option>
            <option value="ethereum">Ethereum</option>
            <option value="bsc">BSC</option>
            <option value="polygon">Polygon</option>
            <option value="arbitrum">Arbitrum</option>
            <option value="optimism">Optimism</option>
            <option value="base">Base</option>
            <option value="avalanche">Avalanche</option>
            <option value="solana">Solana</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="dexFilterType">Type</label>
          <select id="dexFilterType">
            <option value="all">All Types</option>
            <option value="cex_to_dex">CEX → DEX</option>
            <option value="dex_to_cex">DEX → CEX</option>
            <option value="flash_loan">Flash Loan</option>
            <option value="new_pool">New Pool</option>
          </select>
        </div>
        <button id="applyDexFilters">Apply</button>
      </div>

      <table id="dexTable">
        <thead>
          <tr>
            <th>Type</th>
            <th>Symbol</th>
            <th>DEX</th>
            <th>Chain</th>
            <th>Buy</th>
            <th>Sell</th>
            <th>Gross %</th>
            <th>Net %</th>
            <th>Profit</th>
            <th>Gas $</th>
            <th>Liq. $</th>
            <th>Conf.</th>
            <th>Pool</th>
          </tr>
        </thead>
        <tbody id="dexBody">
          <tr class="empty-row">
            <td colspan="13">
              <div class="empty-state">
                <p>🔷 DEX Scanner Active</p>
                <p class="hint">Monitoring 15 DEXs across 8 chains for CEX-DEX arbitrage, flash loans, and new pool opportunities</p>
                <p class="hint">Supported: Uniswap, PancakeSwap, SushiSwap, Raydium, Jupiter, Balancer, Curve, and more</p>
