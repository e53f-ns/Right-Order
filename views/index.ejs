<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <header>
      <h1>Arbitrage Scanner</h1>
      <nav>
        <a href="/" class="active" id="cexTab">CEX Spreads</a>
        <a href="#" id="dexTab">DEX</a>
        <a href="#" id="walletsTab">Wallets</a>
        <a href="#" id="fundingTab">Funding</a>
        <a href="#" id="messagesTab">Messages</a>
        <a href="#" id="nftsTab">NFTs</a>
        <a href="#" id="aiTab">AI</a>
      </nav>
      <div class="connection-status" id="connectionStatus">
        <span class="status-dot disconnected"></span>
        <span id="statusText">Connecting...</span>
      </div>
    </header>

    <div class="stats-bar" id="statsBar">
      <div class="stat-item">
        <span class="stat-label">Active Exchanges</span>
        <span class="stat-value" id="statExchanges"><%= stats.activeExchanges.length %></span>
      </div>
      <div class="stat-item">
        <span class="stat-label">Connected</span>
        <span class="stat-value" id="statConnected"><%= stats.connectedExchanges %>/<%= stats.totalExchanges %></span>
      </div>
      <div class="stat-item">
        <span class="stat-label">Symbols</span>
        <span class="stat-value" id="statSymbols"><%= stats.activeSymbols %></span>
      </div>
      <div class="stat-item">
        <span class="stat-label">Calculations</span>
        <span class="stat-value" id="statCalculations"><%= stats.totalCalculations %></span>
      </div>
      <div class="stat-item">
        <span class="stat-label">Best Net</span>
        <span class="stat-value highlight" id="statBestNet"><%= stats.bestNetPercent %>%</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">Unique Spreads</span>
        <span class="stat-value" id="statOpportunities"><%= stats.opportunitiesCount %></span>
      </div>
    </div>

    <div class="filters" id="cexFilters">
      <div class="filter-row">
        <div class="filter-group">
          <label for="filterType">Type</label>
          <select id="filterType">
            <option value="all">All</option>
            <option value="simple">Simple</option>
            <option value="triangular">Triangular</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="filterSymbol">Symbol</label>
          <input type="text" id="filterSymbol" placeholder="BTC/USDT">
        </div>
        <div class="filter-group">
          <label for="filterExchange">Exchange</label>
          <select id="filterExchange">
            <option value="all">All Exchanges</option>
            <option value="binance">Binance</option>
            <option value="bybit">Bybit</option>
            <option value="okx">OKX</option>
            <option value="kucoin">KuCoin</option>
            <option value="gateio">Gate.io</option>
            <option value="mexc">MEXC</option>
            <option value="htx">HTX</option>
            <option value="bitget">Bitget</option>
            <option value="kraken">Kraken</option>
            <option value="bingx">BingX</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="filterMinGross">Min Gross %</label>
          <input type="number" id="filterMinGross" placeholder="0" step="0.01" value="0">
        </div>
        <div class="filter-group">
          <label for="filterMinNet">Min Net %</label>
          <input type="number" id="filterMinNet" placeholder="-0.5" step="0.01" value="-0.5">
        </div>
        <div class="filter-group">
          <label for="filterMinProfit">Min Profit $</label>
          <input type="number" id="filterMinProfit" placeholder="0" step="1" value="0">
        </div>
        <div class="filter-group">
          <label for="userDeposit">User Deposit $</label>
          <input type="number" id="userDeposit" placeholder="1000" step="100" value="1000">
        </div>
      </div>
      <div class="filter-row">
        <div class="filter-group">
          <label for="filterMinDepth">Min Depth $</label>
          <input type="number" id="filterMinDepth" placeholder="0" step="100" value="0">
        </div>
        <div class="filter-group">
          <label for="filterMinConf">Min Conf %</label>
          <input type="number" id="filterMinConf" placeholder="0" step="5" value="0">
        </div>
        <div class="filter-group">
          <label for="filterMaxAge">Max Age (s)</label>
          <input type="number" id="filterMaxAge" placeholder="120" step="10" value="120">
        </div>
        <div class="filter-group filter-checkbox">
          <label class="checkbox-label">
            <input type="checkbox" id="filterPositiveOnly">
            <span>Positive Net Only</span>
          </label>
        </div>
        <div class="filter-group filter-checkbox">
          <label class="checkbox-label">
            <input type="checkbox" id="filterExecutableOnly" checked>
            <span>Executable Only</span>
          </label>
        </div>
        <div class="filter-group filter-checkbox">
          <label class="checkbox-label">
            <input type="checkbox" id="filterNearProfitable" checked>
            <span>Near Profitable</span>
          </label>
        </div>
        <div class="filter-group">
          <label for="updateInterval">Refresh</label>
          <select id="updateInterval">
            <option value="30000">30 sec</option>
            <option value="60000">1 min</option>
            <option value="300000">5 min</option>
            <option value="600000">10 min</option>
          </select>
        </div>
        <div class="live-indicator" id="liveIndicator">
          <span class="live-dot"></span>
          <span id="liveText">Live updates every 30s</span>
        </div>
        <button id="applyFilters" class="btn">Apply</button>
        <button id="clearFilters" class="btn btn-secondary">Reset</button>
        <div class="filter-spacer"></div>
        <button id="generateTestData" class="btn btn-test">+ Test</button>
        <button id="clearAll" class="btn btn-danger">Clear</button>
      </div>
    </div>

    <div class="table-container" id="cexTableContainer">
      <table id="spreadsTable" class="spreads-table">
        <thead>
          <tr>
            <th>Type</th>
            <th>Symbol / Path</th>
            <th>Buy</th>
            <th>Sell</th>
            <th class="sortable" data-sort="grossPercent">Gross %</th>
            <th class="sortable active" data-sort="netPercent">Net %</th>
            <th class="sortable" data-sort="profitUsd">Profit $</th>
            <th>MinDep</th>
            <th>MaxDep</th>
            <th>Network</th>
            <th>Exec</th>
            <th class="sortable" data-sort="confidence">Conf</th>
            <th class="sortable" data-sort="ageSeconds">Age</th>
          </tr>
        </thead>
        <tbody id="spreadsBody">
          <tr class="empty-row">
            <td colspan="13">
              <div class="empty-state">
                <p>Waiting for spreads...</p>
                <p class="hint">Click "Test" to add sample spreads, or wait for scanner</p>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- DEX Scanner Section (hidden by default) -->
