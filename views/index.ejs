        </tbody>
      </table>
      
      <div class="dex-stats">
        <span id="dexPoolCount">Pools: 0</span>
        <span id="dexOppCount">Opportunities: 0</span>
        <span id="dexLastScan">Last scan: never</span>
      </div>
    </div>

    <!-- Wallets Analysis Section -->
