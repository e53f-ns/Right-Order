            <option value="BTCUSDT">BTC</option>
            <option value="ETHUSDT">ETH</option>
            <option value="SOLUSDT">SOL</option>
            <option value="BNBUSDT">BNB</option>
            <option value="XRPUSDT">XRP</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="fundingExchange">Exchange</label>
          <select id="fundingExchange">
            <option value="all">All Exchanges</option>
            <option value="binance">Binance</option>
            <option value="bybit">Bybit</option>
            <option value="okx">OKX</option>
            <option value="bitget">Bitget</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="fundingDirection">Direction</label>
          <select id="fundingDirection">
            <option value="all">All</option>
            <option value="positive">Positive (Short)</option>
            <option value="negative">Negative (Long)</option>
          </select>
        </div>
      </div>

      <div class="funding-summary">
        <div class="summary-card positive">
          <h4>Top Positive Rate</h4>
          <span id="topPositiveSymbol">-</span>
          <span id="topPositiveRate" class="rate-value">0.00%</span>
        </div>
        <div class="summary-card negative">
          <h4>Top Negative Rate</h4>
          <span id="topNegativeSymbol">-</span>
          <span id="topNegativeRate" class="rate-value">0.00%</span>
        </div>
        <div class="summary-card arbitrage">
          <h4>Best Arbitrage</h4>
          <span id="bestArbSymbol">-</span>
          <span id="bestArbSpread" class="rate-value">0.00%</span>
        </div>
      </div>

      <table id="fundingTable">
        <thead>
          <tr>
            <th>Symbol</th>
            <th>Exchange</th>
            <th>Rate</th>
            <th>APY</th>
            <th>Daily Yield</th>
            <th>Direction</th>
            <th>Next Funding</th>
            <th>Risk</th>
          </tr>
        </thead>
        <tbody id="fundingBody">
