      <div class="section-header">
        <h2>👛 Wallet Analysis</h2>
        <span class="section-status" id="walletStatus">Ready</span>
      </div>
      
      <div class="wallet-input-section">
        <div class="input-group">
          <label for="walletAddress">Wallet Address</label>
