        </thead>
        <tbody id="walletsBody">
          <tr class="empty-row">
            <td colspan="8">
              <div class="empty-state">
                <p>👛 Enter a wallet address to analyze</p>
                <p class="hint">Supports ETH, BSC, Polygon, Arbitrum, Solana</p>
