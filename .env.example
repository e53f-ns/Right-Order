# ══════════════════════════════════════════════
# Right Order — Environment Variables
# ══════════════════════════════════════════════
# Copy this file to .env and fill in all required values
# cp .env.example .env

# ── PostgreSQL ──
# Postgres is NOT exposed to the host in production (docker-compose.yml).
# Reach it via `docker compose exec postgres psql ...` or an SSH tunnel.
POSTGRES_DB=rightorder
POSTGRES_USER=rightorder
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://rightorder:CHANGE_ME_STRONG_PASSWORD@localhost:5432/rightorder?schema=public&connection_limit=15&pool_timeout=20&connect_timeout=10

# ── JWT Secrets (generate with: openssl rand -hex 32) ──
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_HEX_32
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_RANDOM_HEX_32
BCRYPT_ROUNDS=12

# ── Security ──
CORS_ORIGIN=http://localhost:5173
COOKIE_SECRET=CHANGE_ME_COOKIE_SECRET

# ── Stripe Payments ──
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER
STRIPE_PUBLISHABLE_KEY=pk_test_PLACEHOLDER
# Recurring subscription Price IDs (one monthly + one yearly recurring Price
# per plan, created in Stripe Dashboard → Products).
STRIPE_PRICE_PRO_MONTHLY=price_PLACEHOLDER
STRIPE_PRICE_PRO_YEARLY=price_PLACEHOLDER
STRIPE_PRICE_ELITE_MONTHLY=price_PLACEHOLDER
STRIPE_PRICE_ELITE_YEARLY=price_PLACEHOLDER
STRIPE_PRICE_ULTIMATE_MONTHLY=price_PLACEHOLDER
STRIPE_PRICE_ULTIMATE_YEARLY=price_PLACEHOLDER

# ── Crypto Payments (USDT) ──
CRYPTO_USDT_TRC20_ADDRESS=YOUR_TRC20_WALLET
CRYPTO_USDT_ERC20_ADDRESS=YOUR_ERC20_WALLET
CRYPTO_USDT_TON_ADDRESS=YOUR_TON_WALLET

# ── On-chain verification API keys (optional, raises rate limits) ──
ETHERSCAN_API_KEY=
TONCENTER_API_KEY=

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI Assistant ──
GROK_API_KEY=
OPENAI_API_KEY=

# ── Docker Ports ──
# BACKEND_PORT binds to 127.0.0.1 only — internal use / reverse-proxy.
# FRONTEND_PORT is the public entrypoint (nginx → backend reverse proxy).
BACKEND_PORT=3000
FRONTEND_PORT=3100
