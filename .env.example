# Right Order environment example

# PostgreSQL
POSTGRES_DB=rightorder
POSTGRES_USER=rightorder
POSTGRES_PASSWORD=rightorderrulestheworld
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rightorder:CHANGE_ME_STRONG_PASSWORD@localhost:5432/rightorder?schema=public

# JWT / auth
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_HEX_32_OR_MORE
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_RANDOM_HEX_32_OR_MORE
COOKIE_SECRET=CHANGE_ME_COOKIE_SECRET
BCRYPT_ROUNDS=12
EMAIL_VERIFICATION_TTL_MIN=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Email verification
# EMAIL_PROVIDER: auto | smtp | resend
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
RESEND_API_KEY=
EMAIL_FROM="Right Order <your_gmail@gmail.com>"


# Security / CORS
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER
STRIPE_PUBLISHABLE_KEY=pk_test_PLACEHOLDER

# Crypto payments (USDT)
CRYPTO_USDT_TRC20_ADDRESS=YOUR_TRC20_USDT_ADDRESS
CRYPTO_USDT_ERC20_ADDRESS=YOUR_ERC20_USDT_ADDRESS
CRYPTO_WEBHOOK_SECRET=CHANGE_ME_RANDOM_HEX_64
CRYPTO_WEBHOOK_URL=http://localhost:3000/api/payment/crypto/webhook
TRONGRID_API_KEY=
TRON_POLL_MS=15000
TRON_MIN_CONFIRMATIONS=1

# Telegram
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=

# AI
GROK_API_KEY=
OPENAI_API_KEY=

# Ports
BACKEND_PORT=3000
FRONTEND_PORT=80
